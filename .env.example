# 复制本文件为 .env，并填入真实值
# 程序启动时会自动加载 .env 中的环境变量

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production

# LLM 后端（二选一或同时配置）
# Anthropic / Kimi 兼容接口
ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
ANTHROPIC_API_KEY=sk-...

# 或 OpenAI 兼容接口（DeepSeek / Qwen / GLM 等）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...

# 默认文本模型
LLM_MODEL=kimi-k2.6

# OCR 视觉模型（默认跟随 LLM_MODEL，建议显式指定）
VISION_MODEL=kimi-k2.6

# OCR 后端选择：auto | vision | tesseract
OCR_BACKEND=auto

# 开发缓存开关
LLM_CACHE_ENABLED=false

# 监护人同意硬门禁（PIPL）：true 时无有效监护人同意的学生禁止上传试卷。
# 个人自用可保持缺省（关）；正式商用收学生前置 true。
# CONSENT_REQUIRED=true

# HTTPS（生产部署经反向代理终结 TLS 时置 true，启用 Secure cookie）
# HTTPS_ENABLED=true

# 反向代理后取真实客户端 IP（访问码限流按 IP 聚合需要）。
# 生产经 nginx 等单层可信代理时置 true，否则所有用户会坍缩成代理 IP，
# 6 次集体输错即全站封锁。直连开发环境保持缺省（关），防客户端伪造 XFF 绕过限流。
# TRUST_PROXY_HEADERS=true

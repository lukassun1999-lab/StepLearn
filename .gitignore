# 机密与环境配置（严禁入库）
.env
.env.bak_*
cookie*.txt

# 数据文件（含学生个人信息，禁止入库）
data.db
data.db-shm
data.db-wal
data.db.bak_*
*.sqlite
*.sqlite-*

# 学生上传与系统产出（PII）
uploads/
backups/

# OCR 语言包（体积大，本地维护）
tessdata/
*.traineddata
*.traineddata.gz

# 缓存与临时文件
__pycache__/
*.pyc
.pytest_cache/
.llm_cache/
_tmp_*

# 运行日志
logs/

# 归档（仅本地保留）
archive/
scripts/archive/

# 部署产物（含 base64 环境变量，可能有密钥）
.deploy_tmp/
*.bundle

# 运维脚本导出的运行时备份/复核表（含学生数据，不入库）
备份_*.csv
错判人工复核表.csv
